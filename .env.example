# Set public Supabase project values in Vercel for Production and Preview.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-project-publishable-or-anon-key

# Server-only Vercel variables. Never prefix secrets with NEXT_PUBLIC_ or commit real values.
SUPABASE_SERVICE_ROLE_KEY=replace-with-project-service-role-key
ML_SERVICE_URL=https://your-private-ml-service.example
ML_API_KEY=replace-with-shared-ml-secret
# Keep the existing 3500 ms default until staging latency has been measured.
# ML_REQUEST_TIMEOUT_MS=3500
KIOSK_PUBLIC_ORIGIN=https://your-stable-app-domain.example

# Enable only after the SMS SQL, Edge Function, provider credentials and retry schedule are verified.
KIOSK_SMS_ENABLED=0
# CRON_SECRET=replace-with-random-secret-if-using-vercel-cron

# Local hotspot development only (npm run dev selects these automatically):
# KIOSK_LAN_HOST=192.168.1.23
# KIOSK_APP_PORT=3000
